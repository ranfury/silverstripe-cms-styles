{
    "name": "silverstripe-cms-styles",
    "private": true,
    "description": "Builds the client/dist files of ranfury/silverstripe-cms-styles (the package itself is installed with composer)",
    "scripts": {
        "build": "webpack --mode production --config webpack.config.js",
        "watch": "webpack --mode development --watch --config webpack.config.js"
    },
    "engines": {
        "node": ">=20"
    },
    "browserslist": {
        "production": [
            "defaults and supports es6-module"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "license": "BSD-3-Clause",
    "dependencies": {
        "domobserverjs": "^1.0.0",
        "highlight.js": "^11.11.1",
        "js-beautify": "^1.15.4"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "autoprefixer": "^10.5.4",
        "babel-loader": "^10.1.1",
        "css-loader": "^7.1.4",
        "css-minimizer-webpack-plugin": "^8.0.0",
        "mini-css-extract-plugin": "^2.10.2",
        "postcss": "^8.5.25",
        "postcss-loader": "^8.2.1",
        "sass": "~1.105.0",
        "sass-loader": "^17.0.0",
        "terser-webpack-plugin": "^5.6.1",
        "webpack": "^5.109.2",
        "webpack-cli": "^7.2.2",
        "webpack-remove-empty-scripts": "^1.1.1"
    }
}
